# PostgreSQL settings (copy to ../.env before running docker compose)
POSTGRES_DB=pkstt
POSTGRES_USER=pkstt
POSTGRES_PASSWORD=CHANGE_ME_WITH_STRONG_RANDOM_PASSWORD

# API bind port on host loopback (127.0.0.1)
API_PORT=8080

# Sync intervals
STATIC_SYNC_INTERVAL=6h
RT_POLL_INTERVAL=10s

# Security & rate limiting
TRUSTED_PROXY=private
RATE_LIMIT_RPS=15
RATE_LIMIT_BURST=40
CORS_ALLOWED_ORIGINS=*
TIMEZONE=Europe/Warsaw
LOG_LEVEL=info

# Optional: Cloudflare Tunnel token (if using `docker compose --profile tunnel up -d`)
# When configuring the tunnel in Cloudflare Zero Trust, point your public hostname
# (e.g. api.twojadomena.pl) to service: http://api:8080
CLOUDFLARE_TUNNEL_TOKEN=
